; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sumi no Kage"
config/description="Third-person ink-wash action. Asset production phase."
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[filesystem]

import/fbx2gltf/enabled=false
import/blender/enabled=false

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=0
environment/ssil/quality=0
anti_aliasing/quality/msaa_3d=1
global_illumination/sdfgi/probe_ray_count=0
environment/volumetric_fog/volume_size=32
